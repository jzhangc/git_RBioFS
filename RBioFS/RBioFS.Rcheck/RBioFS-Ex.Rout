> ### Aliases: rbioClass_svm
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # default: z-score standardization (center + scale)
> ##D svm_model <- rbioClass_svm(x = training_set[, -1], y = training_set[, 1], kernel = "radial")
> ##D 
> ##D # min-max normalization (each feature mapped to [0, 1])
> ##D svm_mm <- rbioClass_svm(x = training_set[, -1], y = training_set[, 1],
> ##D                          kernel = "radial", center.scale = TRUE, zscore = FALSE, minmax = TRUE)
> ##D 
> ##D # z-score first, then min-max (output in [0, 1])
> ##D svm_zm <- rbioClass_svm(x = training_set[, -1], y = training_set[, 1],
> ##D                          kernel = "radial", zscore = TRUE, minmax = TRUE)
> ##D 
> ##D # no transform (data already pre-processed)
> ##D svm_raw <- rbioClass_svm(x = training_set[, -1], y = training_set[, 1],
> ##D                           kernel = "radial", center.scale = FALSE)
> ## End(Not run)
> 
> 
